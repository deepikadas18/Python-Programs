import tkinter as tk
from tkinter import messagebox

rates = {
    ("INR", "USD"): 0.0104875,
    ("USD", "INR"): 95.3873,
    ("INR", "EUR"): 0.00912093,
    ("EUR", "INR"): 109.64,
    ("INR", "GBP"): 0.00780065,
    ("GBP", "INR"): 128.19
}

def convert():
    try:
        amount = float(amount_entry.get())

        if amount < 0:
            messagebox.showerror("Error", "Amount cannot be negative.")
            return

        from_currency = from_var.get()
        to_currency = to_var.get()

        if from_currency == to_currency:
            result = amount

        elif (from_currency, to_currency) in rates:
            result = amount * rates[(from_currency, to_currency)]

        else:
            messagebox.showerror(
                "Conversion Error",
                "This currency conversion is not available."
            )
            return

        result_label.config(
            text=f"{amount:.2f} {from_currency} = {result:.2f} {to_currency}"
        )

    except ValueError:
        messagebox.showerror(
            "Invalid Input",
            "Please enter a valid numeric amount."
        )

def clear():
    amount_entry.delete(0, tk.END)
    from_var.set("INR")
    to_var.set("USD")
    result_label.config(text="Converted Amount will appear here")

def swap():
    temp = from_var.get()
    from_var.set(to_var.get())
    to_var.set(temp)


root = tk.Tk()
root.title("Currency Converter")
root.geometry("450x420")
root.configure(bg="#EAF4FC")
root.resizable(False, False)

heading = tk.Label(
    root,
    text="Currency Converter",
    font=("Arial", 18, "bold"),
    bg="#EAF4FC",
    fg="#003366"
)
heading.pack(pady=15)

tk.Label(
    root,
    text="Enter Amount",
    font=("Arial", 12),
    bg="#EAF4FC"
).pack()

amount_entry = tk.Entry(
    root,
    font=("Arial", 12),
    width=20
)
amount_entry.pack(pady=5)

currencies = ["INR", "USD", "EUR", "GBP"]

tk.Label(
    root,
    text="From Currency",
    font=("Arial", 11),
    bg="#EAF4FC"
).pack()

from_var = tk.StringVar(value="INR")

from_menu = tk.OptionMenu(root, from_var, *currencies)
from_menu.config(width=10)
from_menu.pack()

tk.Label(
    root,
    text="To Currency",
    font=("Arial", 11),
    bg="#EAF4FC"
).pack()

to_var = tk.StringVar(value="USD")

to_menu = tk.OptionMenu(root, to_var, *currencies)
to_menu.config(width=10)
to_menu.pack(pady=5)

button_frame = tk.Frame(root, bg="#EAF4FC")
button_frame.pack(pady=10)

tk.Button(
    button_frame,
    text="Convert",
    width=10,
    bg="#007ACC",
    fg="white",
    command=convert
).grid(row=0, column=0, padx=5)

tk.Button(
    button_frame,
    text="Swap",
    width=10,
    bg="#6A5ACD",
    fg="white",
    command=swap
).grid(row=0, column=1, padx=5)

tk.Button(
    button_frame,
    text="Clear",
    width=10,
    bg="orange",
    fg="white",
    command=clear
).grid(row=0, column=2, padx=5)

result_label = tk.Label(
    root,
    text="Converted Amount will appear here",
    font=("Arial", 13, "bold"),
    bg="white",
    fg="green",
    width=35,
    height=3,
    relief="groove"
)

result_label.pack(pady=20)

tk.Button(
    root,
    text="Exit",
    width=12,
    bg="red",
    fg="white",
    command=root.destroy
).pack()

root.mainloop()
